# Google Drive API Configuration
# Required for listing files in public/shared folders
GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APP_URL=

# PhonePe Configuration
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
PHONEPE_HOST_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
# Provide Client ID and Secret if your PhonePe integration requires OAuth via Identity Manager
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=

# SMTP Email Configuration
# Titan Mail (e.g., from Hostinger/GoDaddy Professional Email):
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=465 (SSL) or 587 (STARTTLS)
# SMTP_USER=your-email@your-domain.com

# For GoDaddy Workspace / cPanel Email:
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465 (or 587)

# For ZeptoMail:
# SMTP_HOST=smtp.zeptomail.in (or smtp.zeptomail.com depending on your region)
# SMTP_PORT=587 
# SMTP_USER=email (usually "email" is literal for Zeptomail)
# SMTP_PASS=Your ZeptoMail Send Mail Token

SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=raysofmoment@raysofmoment.com
SMTP_PASS=
