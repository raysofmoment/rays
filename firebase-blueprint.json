{
  "entities": {
    "Payment": {
      "title": "Payment",
      "description": "Payment record for an order or booking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "clientId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "method": { "type": "string", "enum": ["online", "manual"] },
        "slipUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "rejected"] },
        "confirmedBy": { "type": "string" },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "clientId", "amount", "date", "method", "status", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "photographer", "editor", "client", "other"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "Photography booking order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "photographerId": { "type": "string" },
        "editorId": { "type": "string" },
        "otherId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "in-progress", "completed", "cancelled"] },
        "date": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "packageName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "discount": { "type": "number" },
        "finalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "status", "date", "totalAmount"]
    },
    "TeamMember": {
      "title": "Team Member",
      "description": "Photography team member details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "specialization": { "type": "string" },
        "bio": { "type": "string" },
        "availability": { "type": "boolean" }
      },
      "required": ["uid"]
    },
    "Gallery": {
      "title": "Gallery",
      "description": "Photo gallery for an order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "clientId": { "type": "string" },
        "name": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "coverUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "clientId", "name"]
    },
    "Photo": {
      "title": "Photo",
      "description": "Individual photo or video in a gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "galleryId": { "type": "string" },
        "url": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "video"] },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["galleryId", "url", "type"]
    },
    "ClientNote": {
      "title": "Client Note",
      "description": "Notes related to client interactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "authorId", "content", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Client review for the photography service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhoto": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "clientName", "rating", "comment", "createdAt"]
    },
