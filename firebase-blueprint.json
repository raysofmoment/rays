        "eventPlace": { "type": "string" },
        "address": { "type": "string" },
        "requirement": { "type": "string" },
        "brideAddress": { "type": "string" },
        "brideNumber": { "type": "string" },
        "brideName": { "type": "string" },
        "brideBengaliName": { "type": "string" },
        "brideFatherName": { "type": "string" },
        "groomAddress": { "type": "string" },
        "groomNumber": { "type": "string" },
        "groomName": { "type": "string" },
        "groomBengaliName": { "type": "string" },
        "groomFatherName": { "type": "string" },
        "childName": { "type": "string" },
        "childBengaliName": { "type": "string" },
        "modelName": { "type": "string" },
        "modelIdLink": { "type": "string" },
