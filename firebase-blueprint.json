        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "designation", "email"]
    },
    "EventCost": {
      "title": "Event Cost",
      "description": "Event-related expenses and photographer details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoice": { "type": "string" },
        "name": { "type": "string" },
        "travelExtra": { "type": "number" },
        "caligraphy": { "type": "number" },
        "weddingVideo": { "type": "number" },
        "weddingTeaser": { "type": "number" },
        "weddingPhoto": { "type": "number" },
        "box": { "type": "number" },
        "other": { "type": "number" },
        "albumDesign": { "type": "number" },
        "albumPrint": { "type": "number" },
        "prePhoto": { "type": "number" },
        "preVideo": { "type": "number" },
        "lidGenerate": { "type": "number" },
        "gift": { "type": "number" },
        "pendrive": { "type": "number" },
        "tvLedProjector": { "type": "number" },
        "photographers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "photographer": { "type": "string" },
              "work": { "type": "string" },
              "payment": { "type": "string" },
              "workReview": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["invoice", "name"]
    },
    "Equipment": {
      "title": "Equipment",
      "description": "Photography equipment details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "purchaseDate": { "type": "string", "format": "date" },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["Available", "In Use", "Repair", "Retired"] },
        "workUsing": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "purchaseDate", "price", "status"]
    },
    "StoreItem": {
      "title": "Store Item",
      "description": "Items available in the store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "purchaseDate": { "type": "string", "format": "date" },
        "price": { "type": "number" },
        "quantity": { "type": "number" },
        "workUsing": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "purchaseDate", "price", "quantity"]
    },
    "JobApplication": {
      "title": "Job Application",
      "description": "Job application details from careers page",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "designation": { "type": "string" },
        "portfolioUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phoneNumber", "designation", "createdAt"]
    },
    "ServiceInquiry": {
      "title": "Service Inquiry",
      "description": "Inquiry for a specific service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceTitle": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "location": { "type": "string" },
        "requirements": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["serviceTitle", "name", "email", "phoneNumber", "location", "requirements", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A notification for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "isRead", "createdAt"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "A blog post created by an admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "coverUrl": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "authorId", "createdAt"]
    },
    "ReminderSent": {
      "title": "Reminder Sent",
      "description": "Tracking for sent event reminders",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string" },
        "sentAt": { "type": "string", "format": "date" },
        "eventDate": { "type": "string", "format": "date" }
      },
      "required": ["bookingId", "sentAt", "eventDate"]
    }
  },
  "firestore": {
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment records"
    },
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/store/{itemId}": {
      "schema": "StoreItem",
      "description": "Store inventory"
    },
    "/equipment/{equipmentId}": {
      "schema": "Equipment",
      "description": "Equipment inventory"
    },
    "/eventCosts/{costId}": {
      "schema": "EventCost",
      "description": "Event expenses"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Employee profiles"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Photography orders"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Detailed bookings"
    },
    "/teamMembers/{uid}": {
      "schema": "TeamMember",
      "description": "Team member details"
    },
    "/galleries/{galleryId}": {
      "schema": "Gallery",
      "description": "Photo galleries"
    },
    "/galleries/{galleryId}/photos/{photoId}": {
      "schema": "Photo",
      "description": "Photos within a gallery"
    },
    "/clientNotes/{noteId}": {
      "schema": "ClientNote",
      "description": "CRM notes for clients"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Client reviews"
    },
    "/jobApplications/{applicationId}": {
      "schema": "JobApplication",
      "description": "Job applications"
    },
    "/serviceInquiries/{inquiryId}": {
      "schema": "ServiceInquiry",
      "description": "Service inquiries"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/blogPosts/{postId}": {
      "schema": "BlogPost",
      "description": "Blog posts"
    },
    "/reminders_sent/{reminderId}": {
      "schema": "ReminderSent",
      "description": "Sent reminder tracking"
    }
  }
}
