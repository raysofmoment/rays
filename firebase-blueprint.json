        "ourWeddingSong": { "type": "string" },
        "eventSong": { "type": "string" },
        "reelsSong": { "type": "string" },
        "songLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "link": { "type": "string" }
            }
          }
        },
        "totalPackageAmount": { "type": "number" },
        "discount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "emi1Date": { "type": "string" },
        "emi2Date": { "type": "string" },
        "emi3Date": { "type": "string" },
        "emi4Date": { "type": "string" },
        "emi5Date": { "type": "string" },
        "emiCount": { "type": "number" },
        "emiAmounts": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "paymentMode": { "type": "string" },
        "photographerName": { "type": "string" },
        "photographerPrice": { "type": "number" },
        "videographerName": { "type": "string" },
        "videographerPrice": { "type": "number" },
        "otherServiceName": { "type": "string" },
        "otherServicePrice": { "type": "number" },
        "photographerId": { "type": "string" },
        "editorId": { "type": "string" },
        "otherId": { "type": "string" },
        "rawFileLink": { "type": "string" },
        "teaserStatus": { "type": "string", "enum": ["delivered", "review", "pending"] },
        "teaserLink": { "type": "string" },
        "fullVideoStatus": { "type": "string", "enum": ["delivered", "review", "pending"] },
        "fullVideoLink": { "type": "string" },
        "videoStatus": { "type": "string", "enum": ["delivered", "review", "pending"] },
        "editPhotoStatus": { "type": "string", "enum": ["delivered", "review", "pending"] },
        "photoEditLink": { "type": "string" },
        "albumDesignStatus": { "type": "string", "enum": ["delivered", "review", "pending"] },
        "albumLink": { "type": "string" },
        "eInviteStatus": { "type": "string", "enum": ["delivered", "review", "pending"] },
        "eInviteLink": { "type": "string" },
        "photoSelectionStatus": { "type": "string", "enum": ["delivered", "review", "pending"] },
        "photoSelectionLink": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "specialRequirement": { "type": "string" },
        "preWeddingVideoStatus": { "type": "string", "enum": ["delivered", "review", "pending"] },
        "preWeddingVideoLink": { "type": "string" },
        "preWeddingPhotoStatus": { "type": "string", "enum": ["delivered", "review", "pending"] },
        "preWeddingPhotoLink": { "type": "string" },
        "otherStatus": { "type": "string", "enum": ["delivered", "review", "pending"] },
        "otherLink": { "type": "string" },
        "reelsStatus": { "type": "string", "enum": ["delivered", "review", "pending"] },
        "reelsLink": { "type": "string" },
        "vlogStatus": { "type": "string", "enum": ["delivered", "review", "pending"] },
        "outputLink": { "type": "string" },
        "discountRequest": { "type": "string" },
        "adminStatus": { "type": "string", "enum": ["requested", "accepted", "rejected"] },
        "finalAmount": { "type": "number" },
        "clientId": { "type": "string" },
        "googleDriveFolderId": { "type": "string" },
        "photographerPaid": { "type": "boolean" },
        "editorPaid": { "type": "boolean" },
        "otherPaid": { "type": "boolean" },
        "staffDetails": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "paymentAmount": { "type": "number" },
              "workQuality": { "type": "string" },
              "review": { "type": "string" },
              "isPaid": { "type": "boolean" }
            }
          }
        },
        "travelCost": { "type": "number" },
        "accommodationCost": { "type": "number" },
        "albumCost": { "type": "number" },
        "katmaniCost": { "type": "number" },
        "pendriveCost": { "type": "number" },
        "boxCost": { "type": "number" },
        "otherCost": { "type": "number" },
        "extraCosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "amount": { "type": "number" }
            }
          }
        },
        "faceRecognitionPhotos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["clientName", "eventDate", "package", "eventType", "totalPackageAmount"]
